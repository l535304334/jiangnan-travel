# 部署环境变量模板 — 复制为 .env 并替换为实际值
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=smart_travel
DB_USER=root
DB_PASS=your_db_password
SPRING_PROFILES_ACTIVE=prod

# 敏感配置 — 生产环境必填
JWT_SECRET=your_jwt_secret_at_least_256_bits
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
AMAP_WEB_API_KEY=your_amap_web_api_key
AMAP_JS_API_KEY=your_amap_js_api_key
AMAP_SECURITY_CODE=your_amap_security_code
